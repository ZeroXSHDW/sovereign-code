# Generated SQLite indexes. These are rebuilt on demand by
# `sovereign skill-db sync` and `sovereign index`; committing them only
# bloats the repository and guarantees a stale copy in every clone.
*.db
*.db-wal
*.db-shm

# Stale decompiled-bytecode test wrappers (not real tests).
*_hidden.py
*_extra_tmp.py

# Self-contained runtime: config, data, gateway files and the model store live
# here after migration. Never commit gigabytes of weights.
runtime/
