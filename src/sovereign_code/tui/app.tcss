Screen {
    background: #0b0b12;
    color: #e8e8f2;
}

Header {
    background: #14141f;
    color: #b794f4;
}

Footer {
    background: #14141f;
    color: #8a8aa0;
}

#body {
    height: 1fr;
}

#sidebar {
    width: 42;
    min-width: 32;
    border-right: solid #2a2a3a;
    padding: 0 1;
    background: #0d0d16;
}

#main {
    width: 1fr;
}

#main VerticalScroll {
    width: 1fr;
}

#bank-row {
    height: auto;
}

#skill-box,
#prompt-box {
    width: 1fr;
    height: auto;
    padding: 0 1;
}

#skill-panel,
#prompt-panel,
#project-panel,
#activity-panel,
#activity-summary {
    height: auto;
}

.card {
    margin: 0 0 1 0;
    padding: 1 2;
    border: round #2a2a3a;
    background: #101018;
}

#project-panel,
#activity-panel {
    min-height: 4;
}

#hint-line {
    margin: 1 2 0 2;
}

MonitorHelp {
    align: center middle;
    background: #000000 60%;
}

#help-dialog {
    width: 74;
    height: auto;
    padding: 1 2;
    border: round #7c5cff;
    background: #101018;
}

#chat-scroll {
    height: 1fr;
    padding: 1 2;
}

#prompt {
    dock: bottom;
    margin: 1 2;
    border: tall #7c5cff;
    background: #12121c;
}

#statusbar {
    height: 1;
    background: #14141f;
    color: #a0a0b8;
    padding: 0 1;
}

#health-panel {
    height: auto;
    padding: 0 2;
    background: #101018;
    border-bottom: solid #2a2a3a;
}

#model-panel {
    margin-top: 0;
    color: #a0a0b8;
}

#activity-summary {
    padding: 0 2;
}

.card.compact {
    margin-bottom: 0;
    padding: 0 2;
}

.section-title {
    color: #b794f4;
    text-style: bold;
    margin: 1 0 0 0;
}

.message {
    margin: 1 0;
    padding: 0 1;
    width: 100%;
}

.message.you {
    border-left: solid #28cd41;
}

.message.assistant {
    border-left: solid #b794f4;
}

.message.system {
    color: #8a8aa0;
    border-left: solid #3a3a50;
}

.hint {
    height: 1;
    color: #6a6a85;
    padding: 0 2;
}

.panel {
    margin-top: 1;
    color: #a0a0b8;
}

#model-list {
    height: auto;
    max-height: 45%;
    background: transparent;
}

ListView > ListItem {
    padding: 0 1;
}

ListView > ListItem.--highlight {
    background: #24243a;
}
